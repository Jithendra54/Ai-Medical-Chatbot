# Put the replacement Google Gemini API key only in your hosting dashboard's secret setting.
# Never commit the real key to GitHub.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
AI_PROVIDER=google

# Optional local Ollama development configuration
OLLAMA_API_KEY=
OLLAMA_API_URL=
OLLAMA_MODEL=

# Optional xAI integration (not required)
XAI_API_KEY=
XAI_MODEL=grok-4.6

RATE_LIMIT_PER_MINUTE=10
