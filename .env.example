# Get an API key from https://console.x.ai/
# Leave blank to run clearly labelled demo mode.
XAI_API_KEY=

# Model ID available to your xAI account. Change if needed.
XAI_MODEL=grok-4.6

# Optional Flask signing secret for future cookie/session features.
FLASK_SECRET_KEY=replace-this-with-a-long-random-value

# Optional per-IP request cap over a rolling 60-second window.
RATE_LIMIT_PER_MINUTE=20
