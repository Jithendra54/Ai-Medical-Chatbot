# Secret for hosted Ollama API. Configure in your hosting dashboard for public deployment.
# Get/manage it at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# For hosted API use https://ollama.com/api/chat; leave blank locally for local inference.
OLLAMA_API_URL=
OLLAMA_MODEL=
AI_PROVIDER=ollama

# Optional xAI integration is not needed for the free Ollama setup.
XAI_API_KEY=
XAI_MODEL=grok-4.6

RATE_LIMIT_PER_MINUTE=20
